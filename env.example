PORT=3000
# OBLIGATORIO: token privado de 32+ caracteres. Debe coincidir con Ajustes > Token THOKAR.
APP_TOKEN=

# Fuente principal de vehículos: api.restart.cl / PRT + SII.
# RESTART_API_KEY es OPCIONAL. Sin key: 5 req/10 s por IP. Con key gratuita: mayor límite.
RESTART_API_KEY=
RESTART_TIMEOUT_MS=12000
# RESTART_BASE_URL=https://api.restart.cl/v1

# Boostr queda como fallback opcional. Si no hay clave, el prototipo sigue funcionando con PRT/reSTART.
BOOSTR_API_KEY=
BOOSTR_TIMEOUT_MS=12000
# BOOSTR_BASE_URL=https://api.boostr.cl

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

PLATE_REQUESTS_PER_MINUTE=12
AI_REQUESTS_PER_MINUTE=30
PLATE_CACHE_MS=21600000
